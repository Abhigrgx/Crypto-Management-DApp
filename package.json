{
  "name": "cryptovault-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "test:contracts": "npm --workspace contracts test",
    "test:backend": "npm --workspace backend test",
    "test:frontend:e2e": "npm --workspace frontend run test:e2e",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
